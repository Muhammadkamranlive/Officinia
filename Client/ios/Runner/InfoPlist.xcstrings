    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هذا التطبيق الكاميرا للسماح لك بالتقاط صورة ملفك الشخصي ورفعها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses the camera to allow you to take and upload your profile picture."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application utilise l'appareil photo pour vous permettre de prendre et de télécharger votre photo de profil."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هذا التطبيق موقعك لعرض الصيدليات القريبة وطالبي العمل وتقديم الاتجاهات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses your location to show nearby pharmacies, jobseekers and provide directions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application utilise votre position pour afficher les pharmacies à proximité, les demandeurs d'emploi et fournir des itinéraires."
          }
        }
      }
    },
