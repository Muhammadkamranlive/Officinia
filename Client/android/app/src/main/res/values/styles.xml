<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android native launch theme (shown BEFORE Flutter draws first frame) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Match Flutter splash background color -->
        <item name="android:windowBackground">#69A88D</item>

        <!-- Prevent default icon/splash behavior -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#69A88D</item>
        <item name="android:navigationBarColor">#69A88D</item>
    </style>

    <!-- Theme AFTER Flutter is ready -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#69A88D</item>
    </style>

</resources>
